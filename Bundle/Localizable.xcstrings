    "unlock.escape_message": {
      "comment": "Guide shown before shielding starts. The argument is the Esc hold duration for this lock in seconds.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch IDで解除できなかった場合は、Escを%lld秒間押し続けるとmacOSのロック画面へ遷移します。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "If you can’t end shielding with Touch ID, hold Esc for %lld second to switch to the macOS lock screen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "If you can’t end shielding with Touch ID, hold Esc for %lld seconds to switch to the macOS lock screen."
                }
              }
            }
          }
        }
      }
    },
    "unlock.secure_event_input": {
      "comment": "Note shown alongside the instructions for ending shielding without the helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーなしでは、伏字欄などでSecure Event Inputが有効になると、解除キーとEscの長押しを検知できません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the helper, key holds for Touch ID and Esc cannot be detected while Secure Event Input is active, such as in a password field."
          }
        }
      }
    },
    "unlock_guide.hide_next_time": {
      "comment": "Checkbox to skip the guide the next time shielding starts.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次から案内を表示しない"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t Show This Guide Again"
          }
        }
      }
    },
    "unlock_guide.message": {
      "comment": "The argument is the number of seconds to hold before Touch ID authentication. The Esc instructions have their own string.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮蔽を解除するには、Esc以外のキーを%lld秒間押し続け、音が鳴ったらTouch IDに触れてください。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To end shielding, hold any key except Esc for %lld second. When you hear the sound, touch the Touch ID sensor."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To end shielding, hold any key except Esc for %lld seconds. When you hear the sound, touch the Touch ID sensor."
                }
              }
            }
          }
        }
      }
    },
    "unlock_guide.selected_key_message": {
      "comment": "The arguments are the display name of the key and the hold duration with its unit.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮蔽を解除するには、%@キーを%@間押し続け、音が鳴ったらTouch IDに触れてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To end shielding, hold %@ for %@. When you hear the sound, touch the Touch ID sensor."
          }
        }
      }
    },
    "unlock_guide.title": {
      "comment": "Title of the guide shown before the displays are shielded.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮蔽の解除方法"
          }
        },
        "en": {
          "stringUnit": {
