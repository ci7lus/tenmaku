    "protection.touch_id_required": {
      "comment": "Touch ID availability could not be verified before starting.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮蔽を開始するにはTouch IDが使える必要があります。システム設定でTouch IDを設定するか、macOSにパスワードでサインインしてからやり直してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID must be available to start shielding. Set up Touch ID in System Settings or sign in to macOS with your password, then try again."
          }
        }
      }
    },
    "protection.touch_id_unavailable": {
      "comment": "Instructions for holding Esc to request the macOS lock screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
