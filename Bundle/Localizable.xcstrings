      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮蔽中、ここで指定した秒数Escを長押しすると、macOSのロックに遷移します。Touch IDが何かしらの制限で使えない場合などに用います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While shielding is active, hold Esc for the number of seconds set here to switch to the macOS lock screen. Use this when Touch ID is unavailable, for example due to a restriction."
          }
        }
      }
    },
