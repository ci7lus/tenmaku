    "walkthrough.lock_message": {
      "comment": "Normal release uses Touch ID. This action locks macOS after a failure.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを続けられなくなったときに、macOSの画面をロックするために使います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permission lets Tenmaku switch to the macOS lock screen if it can no longer maintain the app lock."
          }
        }
      }
    },
    "walkthrough.lock_title": {
      "comment": "Permission to lock macOS if a failure occurs.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロックの操作を許可する"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Locking"
          }
        }
      }
    },
