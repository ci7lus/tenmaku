{
  "sourceLanguage": "en",
  "strings": {
    "common.cancel": {
      "comment": "Button that cancels the operation.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "connection.failed": {
      "comment": "The XPC connection failed.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect."
          }
        }
      }
    },
    "connection.no_response": {
      "comment": "The argument is the error description returned by the OS.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答がありません: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response: %@"
          }
        }
      }
    },
    "connection.timeout": {
      "comment": "The XPC response timed out.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答がありません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response."
          }
        }
      }
    },
    "error.cover_failed": {
      "comment": "Could not start monitoring display configuration changes or gamma.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の再構成とガンマの監視を開始できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start monitoring display configuration and gamma."
          }
        }
      }
    },
    "error.gamma_failed": {
      "comment": "Could not verify the gamma values that shield the displays.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示色を変更できなかった画面があります"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not adjust the colors on some displays."
          }
        }
      }
    },
    "error.input_accessibility_denied": {
      "comment": "Keep the name of the app that needs permission unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TenmakuInputのアクセシビリティを許可してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility for TenmakuInput."
          }
        }
      }
    },
    "error.input_control_monitor_failed": {
      "comment": "Could not start monitoring the event tap.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の制御を監視できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not monitor input control."
          }
        }
      }
    },
    "error.input_control_start_failed": {
      "comment": "Could not start the event tap.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の制御を開始できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start input control."
          }
        }
      }
    },
    "error.input_control_stopped": {
      "comment": "The input event tap is inactive.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の制御が停止しています"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input control has stopped."
          }
        }
      }
    },
    "error.input_controls_held": {
      "comment": "Input controls are still pressed.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押しているキーとクリックを離してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release any keys and mouse buttons you are holding."
          }
        }
      }
    },
    "error.input_device_seize_failed": {
      "comment": "Exclusive access to a physical device failed.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力機器を取得できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not take exclusive control of the input devices."
          }
        }
      }
    },
    "error.input_devices_missing": {
      "comment": "Error returned by the input helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力機器が見つかりません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No input devices were found."
          }
        }
      }
    },
    "error.input_listen_denied": {
      "comment": "Keep the name of the app that needs permission unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TenmakuInputの入力監視を許可してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Input Monitoring for TenmakuInput."
          }
        }
      }
    },
    "error.input_monitoring_denied": {
      "comment": "An OS error without an error code.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視の許可を確認してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the Input Monitoring permission."
          }
        }
      }
    },
    "error.input_monitoring_status": {
      "comment": "The argument is a hexadecimal IOKit status value. Keep it as provided.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視の許可を確認してください（%@）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the Input Monitoring permission (%@)."
          }
        }
      }
    },
    "error.input_permissions_missing": {
      "comment": "Keep the name of the app that needs permission unchanged.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TenmakuInputの入力監視とアクセシビリティの許可を確認してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the Input Monitoring and Accessibility permissions for TenmakuInput."
          }
        }
      }
    },
    "error.input_release_unconfirmed": {
      "comment": "Reports a failure while keeping input blocked.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーとクリックが離されたことを確認できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm that all keys and mouse buttons were released."
          }
        }
      }
    },
    "error.input_session_mismatch": {
      "comment": "The connecting session lacks permission for the helper operation.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このログインセッションからは管理者権限のヘルパーを操作できません。ロックを開始したセッションに戻ってください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This login session cannot control the helper. Return to the session that started the lock."
          }
        }
      }
    },
    "error.invalid_unlock_hold": {
      "comment": "Allowed range for the setting.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しの時間は1〜30秒の間で設定してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the hold duration between 1 and 30 seconds."
          }
        }
      }
    },
    "error.secure_event_input": {
      "comment": "Secure Event Input was detected while running without the helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Event Inputが有効な間は、ヘルパーなしでキー入力を遮断したり長押しを検知したりできません。伏字欄から離れるか、管理者権限のヘルパーを導入してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Secure Event Input is active, Tenmaku needs the helper to block keystrokes and detect key holds. Leave the password field or install the helper."
          }
        }
      }
    },
    "error.session_lock_unconfirmed": {
      "comment": "The macOS lock could no longer be verified during handoff.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのロック画面を確認できなかったため、残っている保護を維持します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenmaku could not verify the macOS lock screen. The remaining protection stays active."
          }
        }
      }
    },
    "error.unknown": {
      "comment": "An unknown XPC error. Treat it as a failure.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックの処理で不明なエラーが発生しました"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unknown lock error occurred."
          }
        }
      }
    },
    "input.permission_control": {
      "comment": "Permissions needed to run without the helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の制御を許可する"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Input Control"
          }
        }
      }
    },
    "input.permission_event_tap_message": {
      "comment": "TenmakuInput is the app that needs permission. The user authenticates in person.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック中にマウスとキーボードの入力をブロックするため、監視とアクセシビリティを許可してください。Secure Event Inputもブロックしたい場合は、戻ってヘルパーを導入してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Input Monitoring and Accessibility to block keyboard and mouse input while locked. To also block input during Secure Event Input, go back and install the helper."
          }
        }
      }
    },
    "input.permission_helper_message": {
      "comment": "TenmakuHelper is the app that needs permission.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーがキーボードとマウスを取得するために、入力監視を許可してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Input Monitoring so the helper can take control of the keyboard and mouse."
          }
        }
      }
    },
    "input.permission_monitoring": {
      "comment": "The macOS Input Monitoring permission.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視を許可する"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Input Monitoring"
          }
        }
      }
    },
    "input.with_helper": {
      "comment": "Current input blocking method.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーあり"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Helper"
          }
        }
      }
    },
    "input.without_helper": {
      "comment": "Current input blocking method.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーなし"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Helper"
          }
        }
      }
    },
    "menu.failed": {
      "comment": "The argument is the localized reason for the failure.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed: %@"
          }
        }
      }
    },
    "menu.handing_off": {
      "comment": "The argument is the localized reason for switching to the lock screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSの画面ロックに切り替えています: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to the macOS lock screen: %@"
          }
        }
      }
    },
    "menu.idle": {
      "comment": "App lock status.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ロック"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked"
          }
        }
      }
    },
    "menu.interrupted": {
      "comment": "The app lock is suspended while macOS is locked.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断中（macOSの画面がロックされています）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupted (macOS Screen Locked)"
          }
        }
      }
    },
    "menu.quit": {
      "comment": "Quits the app.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenmakuを終了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Tenmaku"
          }
        }
      }
    },
    "menu.settings": {
      "comment": "Opens the Settings window.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "menu.shielded": {
      "comment": "App lock status.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        }
      }
    },
    "menu.starting": {
      "comment": "App lock status.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを開始しています…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking…"
          }
        }
      }
    },
    "menu.test_start": {
      "comment": "Shown only in test builds.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮蔽を開始（試験用）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Shielding (Test)"
          }
        }
      }
    },
    "menu.test_stop": {
      "comment": "Shown only in test builds.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮蔽を終了（試験用）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Shielding (Test)"
          }
        }
      }
    },
    "menu.unlock_failed": {
      "comment": "The argument is the localized reason that release failed.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除できませんでした: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not unlock: %@"
          }
        }
      }
    },
    "permission.granted": {
      "comment": "Permission status.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        }
      }
    },
    "permission.helper_required": {
      "comment": "Helper permissions can be checked after installation.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーをインストールしてから確認します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked After Installing Helper"
          }
        }
      }
    },
    "permission.missing": {
      "comment": "Permission status.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未許可"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Allowed"
          }
        }
      }
    },
    "permission.needs_approval": {
      "comment": "The user needs to approve the app in Login Items.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ち"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaiting Approval"
          }
        }
      }
    },
    "permission.not_installed": {
      "comment": "The optional helper is not installed.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未インストール"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Installed"
          }
        }
      }
    },
    "permission.skipped": {
      "comment": "The user skipped the optional installation.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped"
          }
        }
      }
    },
    "permission.unknown": {
      "comment": "The app could not obtain permission.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態を確認できません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could Not Check Status"
          }
        }
      }
    },
    "protection.authentication_failed": {
      "comment": "Touch ID authentication failed or was canceled.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証されませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication was not successful."
          }
        }
      }
    },
    "protection.authentication_timeout": {
      "comment": "Touch ID authentication timed out.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答がありませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication timed out."
          }
        }
      }
    },
    "protection.cover_lost": {
      "comment": "Cover windows are visible while gamma recovers, or cover monitoring could not be verified.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の遮蔽が復旧するか、黒い窓の監視を確認するまで待機しています"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for display shielding to recover or for the emergency cover monitor to respond."
          }
        }
      }
    },
    "protection.displays_unknown": {
      "comment": "Could not enumerate displays.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の構成を確認できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check the display configuration."
          }
        }
      }
    },
    "protection.escape_held": {
      "comment": "Reason the user requested a switch to the lock screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Escの長押しを検知しました"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc was held down."
          }
        }
      }
    },
    "protection.gamma_lost": {
      "comment": "Reason the app lock failed.",
      "extractionState": "manual",
      "localizations": {
