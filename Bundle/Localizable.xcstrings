    },
    "walkthrough.helper_message": {
      "comment": "Installation is optional. Include the limitations of running without the helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーをインストールすると、通常のキーボード操作・マウス操作に加えて、Secure Event Input中も入力を防止することが出来ます。\nいったんスキップして、後からインストールすることも出来ます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing the helper lets Tenmaku block keyboard and mouse input, including while Secure Event Input is active.\nYou can skip this step and install it later."
          }
        }
      }
    },
    "walkthrough.helper_title": {
      "comment": "Make it clear that installation is optional.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーのインストール（任意）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Helper (Optional)"
          }
        }
      }
    },
    "walkthrough.input_control": {
      "comment": "Permission item on the setup completion screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の制御"
          }
        },
        "en": {
