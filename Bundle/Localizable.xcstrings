    "walkthrough.summary_message": {
      "comment": "The argument is the configured hold duration for normal release in seconds. The Esc instructions follow in bold.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューのアイコンからロックを開始します。\n解除するときは、Esc以外のキーを長押し（%lld秒）して、Touch IDに触れます。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Use the menu bar icon to lock.\nTo unlock, hold any key except Esc for %lld second, then touch the Touch ID sensor."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Use the menu bar icon to lock.\nTo unlock, hold any key except Esc for %lld seconds, then touch the Touch ID sensor."
                }
              }
            }
          }
        }
      }
    },
    "walkthrough.summary_title": {
      "comment": "Heading on the setup completion screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "walkthrough.welcome_message": {
      "comment": "Distinguish physical input restrictions from AI control.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中のmacOSを他者の操作から保護できます。\nComputer Useからは操作できる状態をキープします。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent others from using your Mac while work is in progress.\nComputer Use can continue to operate it."
          }
        }
      }
    },
    "walkthrough.welcome_title": {
      "comment": "Setup heading.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenmakuへようこそ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Tenmaku"
          }
        }
      }
