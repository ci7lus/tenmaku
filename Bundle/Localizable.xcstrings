      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロックの操作"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Locking"
          }
        }
      }
