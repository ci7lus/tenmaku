            "state": "translated",
            "value": "Could not register: %@"
          }
        }
      }
    },
    "protection.start": {
      "comment": "Button that starts display shielding and input blocking.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを開始"
          }
        },
