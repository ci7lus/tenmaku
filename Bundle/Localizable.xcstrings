    "protection.state_unknown": {
      "comment": "Could not restore the app lock.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックの状態を確認できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify the lock status."
          }
        }
      }
    },
    "protection.touch_id_unavailable": {
      "comment": "The user must hold Esc to lock macOS.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch IDを使えません。Escを設定した秒数だけ長押しするとロック画面へ移ります"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID is unavailable. Hold Esc for the configured duration to switch to the macOS lock screen."
          }
        }
      }
    },
    "protection.unlock": {
      "comment": "Button that requests Touch ID authentication.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock…"
          }
        }
      }
    },
    "protection.unlock_reason": {
      "comment": "Reason shown in the system Touch ID authentication dialog.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenmakuのロックを解除します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Tenmaku"
          }
        }
      }
    },
    "settings.display_shielding": {
      "comment": "Label for selecting the display shielding method.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作モード"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operating Mode"
          }
        }
      }
    },
    "settings.escape_hold": {
      "comment": "How many seconds to hold Esc to switch to the macOS lock screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Escホールド時間"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc Hold Duration"
          }
        }
      }
    },
    "settings.escape_hold_message": {
      "comment": "Separate from the normal Touch ID release hold duration. Changes take effect at the next lock.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Escを長押ししてmacOSのロック画面へ移るまでの秒数です。Touch IDが無効化された場合などに用います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to hold Esc before switching to the macOS lock screen. Use this when Touch ID is disabled or otherwise unavailable."
          }
        }
      }
    },
    "settings.gamma_and_cover_message": {
      "comment": "Gamma and cover windows run in separate processes.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示色変更（ガンマ値変更）と不透明な表示レイヤーの二重防御で画面の露出を防ぎます。\n表示レイヤーのキャプチャからの除外は仕様として保証されておらず、将来のmacOSバージョンでは映り込んでしまう場合があります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses display color adjustment (gamma adjustment) and an opaque display layer to keep screen contents hidden.\nThe system does not guarantee that the display layer is excluded from captures. It may appear in captures on future versions of macOS."
          }
        }
      }
    },
    "settings.gamma_only_message": {
      "comment": "Mention that another app quitting can also restore gamma.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示色変更のみで画面の露出を防ぎます。\n設定したプロセス（このアプリ以外も含む）が終了したり、画面の構成が変わったりすると、元に戻り、画面の内容が見えてしまうことがあります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses display color adjustment alone to keep screen contents hidden.\nIf a process that applied the adjustment exits, including another app, or the display configuration changes, the colors may reset and reveal the screen contents."
          }
        }
      }
    },
    "settings.general": {
      "comment": "Settings tab name. Use the same translation when referring to the tab in explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "settings.input_blocking": {
      "comment": "Item label used in Settings and on the setup completion screen.",
      "extractionState": "manual",
