    "protection.mirrored": {
      "comment": "Displays switched to mirroring while the app was locked.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラー表示には対応していません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display mirroring is not supported."
          }
        }
      }
    },
    "protection.mirrored_start": {
      "comment": "Display mirroring is unsupported.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラー表示の間はロックを開始できません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot lock while display mirroring is on."
          }
        }
      }
    },
    "protection.registration_failed": {
      "comment": "The argument is the error description returned by the OS.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録できませんでした: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not register: %@"
          }
        }
      }
    },
    "protection.start": {
      "comment": "Button that starts display shielding and input blocking.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを開始"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock"
          }
        }
      }
    },
    "protection.state_unknown": {
      "comment": "Could not restore the app lock.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックの状態を確認できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify the lock status."
          }
        }
      }
    },
    "protection.touch_id_required": {
      "comment": "Touch ID availability could not be verified before starting.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを開始するにはTouch IDが使える必要があります。システム設定でTouch IDを設定するか、macOSにパスワードでサインインしてからやり直してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID must be available to start the lock. Set up Touch ID in System Settings or sign in to macOS with your password, then try again."
          }
        }
      }
    },
    "protection.touch_id_unavailable": {
      "comment": "The user must hold Esc to lock macOS.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch IDを使えません。Escの長押しでmacOSのロック画面への切り替えを要求できます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID is unavailable. Hold Esc to request the macOS lock screen."
          }
        }
      }
    },
    "protection.unlock": {
      "comment": "Button that requests Touch ID authentication.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock…"
          }
        }
      }
    },
    "protection.unlock_reason": {
      "comment": "Reason shown in the system Touch ID authentication dialog.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenmakuのロックを解除します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Tenmaku"
          }
        }
      }
    },
    "settings.escape_hold": {
      "comment": "How many seconds to hold Esc to switch to the macOS lock screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Escホールド時間"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc Hold Duration"
          }
        }
      }
    },
    "settings.escape_hold_message": {
      "comment": "Separate from the normal Touch ID release hold duration. Changes take effect at the next lock.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Escを長押ししてmacOSのロック画面へ移るまでの秒数です。Touch IDが無効化された場合などに用います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to hold Esc before switching to the macOS lock screen. Use this when Touch ID is disabled or otherwise unavailable."
          }
        }
      }
    },
    "settings.general": {
      "comment": "Settings tab name. Use the same translation when referring to the tab in explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "settings.input_blocking": {
      "comment": "Item label used in Settings and on the setup completion screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の遮断"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Blocking"
          }
        }
      }
    },
    "settings.unlock_hold": {
      "comment": "Label for the hold duration in General settings. The counter on the right shows the number of seconds.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除ホールド時間"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Duration to Unlock"
          }
        }
      }
    },
    "settings.unlock_hold_message": {
      "comment": "Holding the key requests authentication. Successful Touch ID authentication ends shielding.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除するには、Esc以外のキーをここで指定した秒数だけ押したあと、Touch IDに触れます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock, hold any key except Esc for the number of seconds set here, then touch the Touch ID sensor."
          }
        }
      }
    },
    "settings.unlock_hold_seconds": {
      "comment": "Hold duration counter. Shows only a whole number from 1 to 30 and the unit in seconds.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld秒"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld second"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld seconds"
                }
              }
            }
          }
        }
      }
    },
    "settings.walkthrough": {
      "comment": "Settings tab name. Use the same translation when referring to the tab in explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめに"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting Started"
          }
        }
      }
    },
    "unlock.escape_message": {
      "comment": "The argument is the Esc hold duration for this lock in seconds. Used on the setup completion screen and in the guide shown before starting.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch IDで解除できなかった後は、Escを%lld秒間押し続けるとmacOSのロック画面への切り替えを要求できます。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "After a failed Touch ID attempt, hold Esc for %lld second to request the macOS lock screen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "After a failed Touch ID attempt, hold Esc for %lld seconds to request the macOS lock screen."
                }
              }
            }
          }
        }
      }
    },
    "unlock.secure_event_input": {
      "comment": "Note shown alongside the instructions for ending shielding without the helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーなしでは、伏字欄などでSecure Event Inputが有効になると、解除キーとEscの長押しを検知できません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the helper, key holds for Touch ID and Esc cannot be detected while Secure Event Input is active, such as in a password field."
          }
        }
      }
    },
    "unlock_guide.hide_next_time": {
      "comment": "Checkbox to skip the guide for future locks.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次から案内を表示しない"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t Show This Guide Again"
          }
        }
      }
    },
    "unlock_guide.message": {
      "comment": "The argument is the number of seconds to hold before Touch ID authentication. The Esc instructions have their own string.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除するには、Esc以外のキーを%lld秒間押し続け、音が鳴ったらTouch IDに触れてください。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To unlock, hold any key except Esc for %lld second. When you hear the sound, touch the Touch ID sensor."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To unlock, hold any key except Esc for %lld seconds. When you hear the sound, touch the Touch ID sensor."
                }
              }
            }
          }
        }
      }
    },
    "unlock_guide.title": {
      "comment": "Title of the guide shown before the displays are shielded.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックの解除方法"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to Unlock"
          }
        }
      }
    },
    "walkthrough.back": {
      "comment": "Goes to the previous setup page.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
