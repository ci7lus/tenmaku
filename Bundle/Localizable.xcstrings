    "walkthrough.done": {
      "comment": "Closes setup after completion.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "walkthrough.helper_message": {
      "comment": "Installation is optional. Include the limitations of running without the helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーをインストールすると、通常のキーボード操作・マウス操作に加えて、Secure Event Input中も入力を防止することが出来ます。\nいったんスキップして、後からインストールすることも出来ます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing the helper lets Tenmaku block keyboard and mouse input, including while Secure Event Input is active.\nYou can skip this step and install it later."
          }
        }
      }
    },
    "walkthrough.helper_title": {
      "comment": "Make it clear that installation is optional.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーのインストール（任意）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Helper (Optional)"
          }
        }
      }
    },
    "walkthrough.input_control": {
      "comment": "Permission item on the setup completion screen.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の制御"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Control"
          }
        }
      }
    },
    "walkthrough.install": {
      "comment": "Installs the optional helper.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install"
          }
        }
      }
    },
    "walkthrough.lock_message": {
      "comment": "Normal release uses Touch ID. This action locks macOS after a failure.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを続けられなくなったときに、macOSの画面をロックするために使います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permission lets Tenmaku switch to the macOS lock screen if it can no longer maintain the app lock."
          }
        }
      }
    },
    "walkthrough.lock_title": {
      "comment": "Permission to lock macOS if a failure occurs.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロックの操作を許可する"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Locking"
          }
        }
      }
    },
    "walkthrough.next": {
      "comment": "Goes to the next setup page.",
